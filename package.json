{
  "name": "sabas-docs",
  "version": "1.0.0",
  "description": "Sabas OS documentation site powered by Antora",
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "build:local": "antora --fetch antora-playbook-local.yml",
    "serve": "npx http-server build/site -p 3000 -o",
    "dev": "npm run build:local && npm run serve",
    "clean": "rm -rf build"
  },
  "devDependencies": {
    "@antora/cli": "3.1.9",
    "@antora/site-generator": "3.1.9",
    "http-server": "^14.1.1"
  }
}
